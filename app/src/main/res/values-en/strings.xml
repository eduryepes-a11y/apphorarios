    <string name="diag_alarm_mode">Alarm mode</string>
    <string name="diag_alarm_mode_text">Schedules reminders as system alarms. Most reliable on Xiaomi, Huawei, Oppo… (you\'ll see an alarm icon in the status bar).</string>
    <string name="diag_section_test">Test</string>
    <string name="diag_enable_first">Turn on notifications first</string>
    <string name="diag_test_now">Test now</string>
    <string name="diag_test_1min">Test in 1 min</string>
    <string name="diag_test_scheduled">Test reminder in 1 minute. Close the app and lock your phone.</string>
    <string name="diag_test_explain">“Test now” checks that your phone shows notifications. “Test in 1 min” checks that the alarm arrives with the app closed: if it doesn\'t show up, the problem is battery saving or the manufacturer\'s autostart.</string>
    <string name="diag_section_log">Reminder history</string>
    <string name="diag_log_empty">No alarm has arrived yet. When a reminder fires it will show up here, even if the notification isn\'t displayed.</string>
    <string name="diag_log_explain">If nothing shows up here at the time of an activity, the alarm didn\'t arrive (your phone blocked it): turn on “Alarm mode” and remove battery restrictions.</string>
    <string name="diag_section_device">For your phone</string>
    <string name="diag_device">Detected phone: %1$s</string>
    <string name="diag_open_app_settings">Open app settings</string>
    <string name="tip_xiaomi">On Xiaomi: App settings › turn on “Autostart” and set “Battery saver” to “No restrictions”. Also turn on “Alarm mode” above.</string>
    <string name="tip_samsung">On Samsung: App settings › Battery › “Unrestricted”. Also make sure the app isn\'t in “Sleeping apps” (Settings › Device care › Battery › Background usage limits).</string>
    <string name="tip_huawei">On Huawei/Honor: Settings › Battery › App launch › Horarios › “Manage manually” and turn on all three options. Also turn on “Alarm mode”.</string>
    <string name="tip_oppo">On Oppo/Realme/OnePlus/Vivo: App settings › Battery usage › allow “Background activity” and “Auto launch”. Also turn on “Alarm mode”.</string>
    <string name="tip_generic">App settings › Battery › “Unrestricted”. If reminders still don\'t arrive, turn on “Alarm mode”.</string>
